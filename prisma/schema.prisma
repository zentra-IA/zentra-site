generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id String @id @default(cuid())

  name String
  whatsapp String
  company String
  problem String

  stage String @default("NEW")

  source String?
  destination String?

  notes String? @default("")

  meetingDate DateTime?   // 👈 NOVO CAMPO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}